# Private deployment configuration example.
#
# Copy this file to .deployment.env and chmod 600 .deployment.env. It contains
# private-checkout coordinates and optional non-secret runtime overrides only.
# The wrapper loads .deployment.env first, then .env. Put credentials, chat IDs,
# and private CV placeholder values in the separate mode-600 .env file.

# CONFIG_REPOSITORY | purpose: Private configuration repository in owner/repository form, consumed by GitHub Actions and the local helper. | type: repository | default: null | allowed: owner/repository | env: CONFIG_REPOSITORY | constraints: ^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$ | dependencies: private checkout must authorize the deploy key | effect: selects the private configuration repository | status: active | consumed_by: github_actions, private_config_helper
CONFIG_REPOSITORY=example-org/private-job-search-config
# CONFIG_REF | purpose: Private configuration revision consumed by GitHub Actions and the local helper; must be a lowercase 40-hex commit SHA. | type: git_ref | default: null | allowed: lowercase immutable 40-character commit SHA | env: CONFIG_REF | constraints: ^[0-9a-f]{40}$ | dependencies: must resolve in CONFIG_REPOSITORY | effect: pins the private configuration revision | status: active | consumed_by: github_actions, private_config_helper
CONFIG_REF=0123456789abcdef0123456789abcdef01234567
# CONFIG_SSH_KEY | purpose: Path to the read-only private configuration SSH key; the path itself is not secret. | type: path | default: "$HOME/.ssh/job_search_config_ed25519" | allowed: readable local private-key path | env: CONFIG_SSH_KEY | constraints: file=true, readable=true | dependencies: required by prepare-private-config.sh on a host | effect: authenticates private configuration fetch | status: active | consumed_by: private_config_helper
CONFIG_SSH_KEY=$HOME/.ssh/job_search_config_ed25519
# JOB_SEARCH_SETTINGS_FILE | purpose: Selects the versioned TOML file when nonempty. | type: path | default: "" | allowed: readable TOML path | env: JOB_SEARCH_SETTINGS_FILE | dependencies: fetch also needs an explicit search setting | effect: selects the data-only configuration file
# Leave unset for the wrapper's repo-relative private checkout default.
# JOB_SEARCH_SETTINGS_FILE=.private-config/job-search-config/job_search.toml

# The deployment helper is the only private-config fetch path:
#   scripts/prepare-private-config.sh --sync
#   scripts/prepare-private-config.sh --check-only
# The latter is read-only and network-free. Neither command changes .env.

# Optional non-secret overrides. They are all commented so a copied template
# cannot silently replace private TOML settings. Uncomment only a deliberate
# host-specific override.
# EVAL_WORKERS=4
# TAILOR_WORKERS=2
# SCRAPE_BUDGET_SECONDS=600
# LINKEDIN_BUDGET_SECONDS | purpose: LinkedIn Guest source time budget; defaults from the fetch budget. | type: positive_duration_seconds | default: "max(60, SCRAPE_BUDGET_SECONDS * 0.85)" | allowed: positive seconds | env: LINKEDIN_BUDGET_SECONDS | dependencies: derives from SCRAPE_BUDGET_SECONDS when unset | effect: caps LinkedIn Guest fetching
# LINKEDIN_BUDGET_SECONDS=510
# settings.latex_max_workers | purpose: Concurrent LaTeX workers. | type: positive_int | default: 2 | allowed: integer at least 1 | env: LATEX_MAX_WORKERS / XELATEX_MAX_WORKERS | dependencies: host must have LaTeX when CV work runs | effect: limits concurrent compiles
# LATEX_MAX_WORKERS=1
# XELATEX_MAX_WORKERS=1
# settings.llm_breaker_threshold | purpose: Primary LLM circuit-break threshold. | type: positive_int | default: 2 | allowed: integer at least 1 | env: LLM_BREAKER_THRESHOLD | dependencies: applies after retryable primary failures | effect: disables the primary for the current run at the threshold
# LLM_BREAKER_THRESHOLD=2
# settings.anthropic_max_tokens | purpose: Anthropic response token limit. | type: positive_int | default: 4096 | allowed: integer at least 1 | env: ANTHROPIC_MAX_TOKENS | dependencies: used by the Anthropic scheme | effect: caps Anthropic response tokens
# ANTHROPIC_MAX_TOKENS=4096

# Source, output, and provider aliases can override TOML for an operational
# host. Legacy names remain supported: GEMINI_MODEL, GEMINI_API_KEY,
# GEMINI_API_BASE, OPENAI_API_KEY, and XELATEX_MAX_WORKERS.
# SOURCES_ENABLE=
# SOURCES_DISABLE=
# CV_MAX_PAGES=1
# CV_DISPLAY_NAME=Avery Example
# CV_FILENAME_PREFIX=avery_example_cv
# BASE_TEX_FILE=.private-config/job-search-config/avery_example_base.tex
# OUT_PDF_FILE=build/avery_example_base.pdf
# OUTPUT_MODE=plain
# OUTPUT_DIR=generated
# OUTPUT_CV_MODE=disabled
# DIGEST_DELIVERY=1
# STATE_SYNC=0
# LLM_PRIMARY_SCHEME=openai
# LLM_PRIMARY_MODEL=fictional-platform-model
# LLM_PRIMARY_API_BASE=https://llm.example.test/v1
# LLM_PRIMARY_AUTH_MODE=bearer
# LLM_FALLBACK_SCHEME=openai
# LLM_FALLBACK_MODEL=fictional-fallback-model
# LLM_FALLBACK_API_BASE=https://backup-llm.example.test/v1
# LLM_FALLBACK_AUTH_MODE=bearer
# LATEX_ENGINE=pdflatex
# PROMPT_DIR=
# PROMPT_REVISION=
# SEEN_JOBS_FILE=state/seen_jobs.json
# CRITERIA_FILE=criteria.md
# CV_TAILORING_PROMPT_FILE=cv_tailoring_prompt.md
# SECTIONS_FILE=sections.py
# GEMINI_MODEL=legacy-primary-model
# GEMINI_API_BASE=https://legacy-llm.example.test

# The following values belong in .env or the equivalent protected service
# environment. They are environment-only and sensitive; do not copy their
# placeholder assignments into .deployment.env.
# settings.llm_primary_api_key | purpose: Primary LLM credential. | type: string | default: "" | allowed: nonempty provider credential | env: LLM_PRIMARY_API_KEY / GEMINI_API_KEY | dependencies: required by authenticated primary requests | effect: authenticates primary requests | sensitive
# LLM_PRIMARY_API_KEY=replace-with-primary-api-key
# GEMINI_API_KEY=replace-with-legacy-primary-key
# settings.llm_fallback_api_key | purpose: Fallback LLM credential. | type: string | default: "" | allowed: nonempty provider credential | env: LLM_FALLBACK_API_KEY / OPENAI_API_KEY | dependencies: used when the fallback provider serves a request | effect: authenticates fallback requests | sensitive
# LLM_FALLBACK_API_KEY=replace-with-fallback-api-key
# OPENAI_API_KEY=replace-with-legacy-fallback-key
# settings.telegram_bot_token | purpose: Telegram delivery credential. | type: string | default: "" | allowed: nonempty bot token | env: TELEGRAM_BOT_TOKEN | dependencies: required for Telegram output | effect: authenticates Telegram delivery | sensitive
# TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
# settings.telegram_chat_id | purpose: Telegram destination chat. | type: string | default: "" | allowed: authorized chat identifier | env: TELEGRAM_CHAT_ID | dependencies: required for Telegram output | effect: selects Telegram recipient | sensitive
# TELEGRAM_CHAT_ID=replace-with-authorized-chat-id
# settings.telegraph_access_token | purpose: Telegraph credential. | type: string | default: "" | allowed: nonempty access token | env: TELEGRAPH_ACCESS_TOKEN | dependencies: required only for Telegraph publishing | effect: authenticates Telegraph publishing | sensitive
# TELEGRAPH_ACCESS_TOKEN=replace-with-telegraph-token
# CV_PHONE=replace-with-private-phone
# CV_EMAIL=avery@example.invalid

# JOB_SEARCH_CONFIG_FILE | purpose: Optional trusted executable Python composition hook; an absent variable checks the default path, while an explicit empty value is an error. | type: path | default: "job_search_config.py" | allowed: reviewed Python path | env: JOB_SEARCH_CONFIG_FILE | dependencies: executes only during runtime check or run | effect: customizes the built runtime | absent_behavior: optionally_load_default_path | absent_path: job_search_config.py | empty_behavior: error | execution: trusted_python
# Local-host only; the Actions private-config checkout does not select this hook.
# JOB_SEARCH_CONFIG_FILE=job_search_config.py
# JOB_SEARCH_CONFIG_PY | purpose: GitHub Actions secret materialized as the legacy Python hook. | type: string | default: "" | allowed: reviewed Python source | env: JOB_SEARCH_CONFIG_PY | dependencies: legacy workflow transport only | effect: supplies a legacy custom hook | sensitive
# SECTIONS_PY | purpose: GitHub Actions variable materialized as the configured sections file. | type: string | default: "" | allowed: reviewed sections source | env: SECTIONS_PY | dependencies: legacy workflow transport only | effect: supplies legacy presentation grouping

# Active GitHub Actions controls. Use Actions Variables for the first three and
# an Actions Secret for the deploy key. The scheduled job skips unless
# PERSONAL_RUNS_ENABLED is exactly true; manual runs preflight all four values.
# PERSONAL_RUNS_ENABLED | purpose: GitHub Actions host control for personal scheduled runs. | type: boolean | default: null | allowed: true or false | env: PERSONAL_RUNS_ENABLED | dependencies: workflow checks it before scheduled work | effect: gates scheduled private runs | status: active | consumed_by: github_actions
# PERSONAL_RUNS_ENABLED=true
# CONFIG_DEPLOY_KEY | purpose: GitHub Actions secret deploy key for the configuration repository. | type: ssh_private_key | default: null | allowed: read-only private deploy key | env: CONFIG_DEPLOY_KEY | dependencies: CONFIG_REPOSITORY must authorize it | effect: authenticates the pinned private checkout | sensitive | status: active | consumed_by: github_actions
# CONFIG_DEPLOY_KEY=replace-with-read-only-deploy-key
