# Host-only deployment settings. Copy selected lines to a mode-600 .env or set
# them in the service environment. All values below are fictional placeholders.
# Never commit a real credential, phone number, private CV value, or chat ID.

# JOB_SEARCH_SETTINGS_FILE | purpose: Selects the versioned TOML file when nonempty. | type: path | default: "" | allowed: existing TOML path | env: JOB_SEARCH_SETTINGS_FILE | dependencies: file needs settings.version=1 | effect: chooses data-only settings input
# Select a versioned data-only TOML configuration. This file is read at startup.
JOB_SEARCH_SETTINGS_FILE=/srv/job-search/job_search.toml

# Sensitive credentials: use a secret manager, GitHub Actions Secrets, or a
# protected .env. These placeholder values are intentionally unusable.
LLM_PRIMARY_API_KEY=replace-with-primary-api-key
LLM_FALLBACK_API_KEY=replace-with-fallback-api-key
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_CHAT_ID=replace-with-authorized-chat-id
TELEGRAPH_ACCESS_TOKEN=replace-with-telegraph-token
CV_EMAIL=avery@example.invalid
CV_PHONE=replace-with-private-phone

# Provider and host controls. The old provider-specific aliases remain supported
# during migration: GEMINI_MODEL/GEMINI_API_KEY/GEMINI_API_BASE and OPENAI_API_KEY.
LLM_PRIMARY_SCHEME=openai
LLM_PRIMARY_MODEL=fictional-platform-model
LLM_PRIMARY_API_BASE=https://llm.example.test/v1
LLM_PRIMARY_AUTH_MODE=bearer
LLM_FALLBACK_SCHEME=openai
LLM_FALLBACK_MODEL=fictional-fallback-model
LLM_FALLBACK_API_BASE=https://backup-llm.example.test/v1
LLM_FALLBACK_AUTH_MODE=bearer
# GEMINI_MODEL=legacy-primary-model
# GEMINI_API_KEY=replace-with-legacy-primary-key
# GEMINI_API_BASE=https://legacy-llm.example.test
# OPENAI_API_KEY=replace-with-legacy-fallback-key

# Environment overrides take precedence over TOML. Leave unset to use the TOML
# value, then catalog default. CSV values apply to the named tuple settings.
EVAL_WORKERS=4
TAILOR_WORKERS=2
SCRAPE_BUDGET_SECONDS=600
# LINKEDIN_BUDGET_SECONDS | purpose: LinkedIn Guest source time budget; defaults from the fetch budget. | type: positive_duration_seconds | default: "max(60, SCRAPE_BUDGET_SECONDS * 0.85)" | allowed: positive seconds | env: LINKEDIN_BUDGET_SECONDS | dependencies: defaults from SCRAPE_BUDGET_SECONDS when unset | effect: caps only LinkedIn Guest fetching
LINKEDIN_BUDGET_SECONDS=510
SOURCES_ENABLE=
SOURCES_DISABLE=
CV_MAX_PAGES=1
CV_DISPLAY_NAME=Avery Example
CV_FILENAME_PREFIX=avery_example_cv
BASE_TEX_FILE=/srv/job-search/avery_example_base.tex
OUT_PDF_FILE=build/avery_example_base.pdf
OUTPUT_MODE=plain
OUTPUT_DIR=generated
OUTPUT_CV_MODE=disabled
DIGEST_DELIVERY=1
STATE_SYNC=0

# Host-only compatibility/tuning controls. LATEX_MAX_WORKERS wins over the
# legacy XELATEX_MAX_WORKERS when both are set. `none` auth is only for an
# explicitly configured, trusted local OpenAI-compatible endpoint.
LATEX_MAX_WORKERS=1
# XELATEX_MAX_WORKERS=1
LLM_BREAKER_THRESHOLD=2
ANTHROPIC_MAX_TOKENS=4096
LATEX_ENGINE=pdflatex
PROMPT_DIR=
PROMPT_REVISION=
SEEN_JOBS_FILE=state/seen_jobs.json
CRITERIA_FILE=criteria.md
CV_TAILORING_PROMPT_FILE=cv_tailoring_prompt.md
SECTIONS_FILE=sections.py

# Trusted executable escape hatch. A nonempty path executes Python during the
# runtime check/run; keep it reviewed and free of credentials. It is purposely
# ignored by --describe-config and --validate-config.
# JOB_SEARCH_CONFIG_FILE | purpose: Optional trusted executable Python composition hook; an absent variable checks the default path, while an explicit empty value is an error. | type: path | default: "job_search_config.py" | allowed: existing reviewed Python path | env: JOB_SEARCH_CONFIG_FILE | absent_behavior: optionally_load_default_path | absent_path: job_search_config.py | empty_behavior: error | execution: trusted_python | dependencies: executes only during runtime check/run | effect: customizes built runtime
# JOB_SEARCH_CONFIG_FILE=/srv/job-search/job_search_config.py

# GitHub Actions migration: store sensitive values above in Actions Secrets and
# non-secret provider controls in Actions Variables. A workflow must explicitly
# materialize source transport after checkout. PERSONAL_RUNS_ENABLED,
# CONFIG_REPOSITORY, CONFIG_REF, and CONFIG_DEPLOY_KEY are planned for PR2 and
# inactive in PR1; their examples below document the future interface only.
# PERSONAL_RUNS_ENABLED | purpose: Planned GitHub Actions host control for personal scheduled runs; not active in PR1. | type: boolean | default: null | allowed: true or false | env: PERSONAL_RUNS_ENABLED | status: planned | consumed_by: deployment_pr2 | dependencies: deployment_pr2 must implement the control | effect: will gate personal scheduled runs
# PERSONAL_RUNS_ENABLED=true
# CONFIG_REPOSITORY | purpose: Planned GitHub Actions configuration repository control; not active in PR1. | type: repository | default: null | allowed: owner/repository | env: CONFIG_REPOSITORY | status: planned | consumed_by: deployment_pr2 | dependencies: deployment_pr2 needs read access | effect: will select private configuration repository
# CONFIG_REPOSITORY=example-org/private-job-search-config
# CONFIG_REF | purpose: Planned GitHub Actions configuration revision control; not active in PR1. | type: git_ref | default: null | allowed: full immutable commit SHA | env: CONFIG_REF | status: planned | consumed_by: deployment_pr2 | dependencies: deployment_pr2 must resolve it in CONFIG_REPOSITORY | effect: will pin private configuration revision
# CONFIG_REF=0123456789abcdef0123456789abcdef01234567
# CONFIG_DEPLOY_KEY | purpose: Planned GitHub Actions secret deploy key for the configuration repository; not active in PR1. | type: ssh_private_key | default: null | allowed: read-only private deploy key | env: CONFIG_DEPLOY_KEY | status: planned | consumed_by: deployment_pr2 | dependencies: deployment_pr2 CONFIG_REPOSITORY must authorize it; sensitive | effect: will authenticate private configuration checkout
# CONFIG_DEPLOY_KEY=replace-with-read-only-deploy-key
# JOB_SEARCH_CONFIG_PY | purpose: GitHub Actions secret materialized as the legacy Python hook. | type: string | default: "" | allowed: reviewed Python source | env: JOB_SEARCH_CONFIG_PY | dependencies: an Actions workflow must materialize it; sensitive | effect: supplies custom runtime hook
# JOB_SEARCH_CONFIG_PY=<multiline reviewed Python source: use an Actions Secret>
# SECTIONS_PY | purpose: GitHub Actions variable materialized as the configured sections file. | type: string | default: "" | allowed: reviewed sections.py source | env: SECTIONS_PY | dependencies: an Actions workflow must materialize it | effect: supplies optional presentation grouping
# SECTIONS_PY=<multiline sections.py source: use an Actions Variable>
